NODE_ENV=development

APP_HOST=0.0.0.0
APP_PORT=3000
APP_SHUTDOWN_TIMEOUT_MS=10000

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=3000

RABBITMQ_URL=amqp://marketplace:marketplace@localhost:5672
RABBITMQ_EXCHANGE=marketplace.events
RABBITMQ_PUBLISH_TIMEOUT_MS=5000

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

EVENT_LOOP_LAG_THRESHOLD_MS=500
